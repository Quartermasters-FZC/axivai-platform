#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# ─────────────────────────────────────────────────────────────────────────────────

# Database (MySQL). Local docker-compose: mysql://axivai:axivai_dev_password@127.0.0.1:3307/axivai
# Hostinger: use host 127.0.0.1 and port 3306, not localhost.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/axivai"

# Gap report form: random secret used to hash submitter IPs for rate limiting
GAP_REPORT_IP_SALT="generate-a-secure-random-string"

# Research & Data APIs
NEWS_API_KEY="..."
SERPAPI_KEY="..."
EIA_API_KEY="..."
EXA_API_KEY="..."
HIGHERGOV_API_KEY="..."

# Authentication
NEXTAUTH_SECRET="generate-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# Google Maps
GOOGLE_MAPS_API_KEY="..."
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="..."
