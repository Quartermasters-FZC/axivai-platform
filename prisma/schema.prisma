// Production: Hostinger MySQL (app connects to 127.0.0.1:3306).
// Local: MySQL 8 from docker-compose.yml.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// POWER-ACCESS GAP REPORTS (Stage I problem mapping)
// See docs/planning/AXIVAI_Improved_Concept_Paper_October_2026.md §10
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model GapReport {
  id                String           @id @default(cuid())
  createdAt         DateTime         @default(now())

  // Who is reporting
  organizationType  OrganizationType
  organizationName  String?          @db.VarChar(200)
  role              String?          @db.VarChar(120)
  contactName       String?          @db.VarChar(120)
  email             String?          @db.VarChar(254)
  followUpConsent   Boolean          @default(false)

  // Where
  state             String           @db.Char(2)
  city              String?          @db.VarChar(120)

  // The problem (concept paper §2)
  problemType       ProblemType
  application       String           @db.VarChar(80)
  description       String           @db.Text

  // The need (concept paper §7.1) — all optional; "unknown" is a valid answer
  peakKw            Int?
  dailyKwh          Int?
  durationNeeded    DurationNeeded?
  utilityDelay      UtilityDelay?
  currentApproach   String?          @db.Text
  costOfDelay       String?          @db.Text

  // Abuse controls
  ipHash            String?          @db.Char(64)

  @@index([createdAt])
  @@index([state])
  @@index([problemType])
  @@index([ipHash, createdAt])
}

enum OrganizationType {
  SCHOOL_DISTRICT
  FLEET_OPERATOR
  CONSTRUCTION
  INDUSTRIAL
  PORT_LOGISTICS
  UTILITY
  GOVERNMENT
  EMERGENCY_MANAGEMENT
  CONSULTANT
  OTHER
}

enum ProblemType {
  CONNECTION_DELAY
  PEAK_CAPACITY
  TEMPORARY_DEMAND
  RESILIENCE_GAP
  REMOTE_LOAD
  NOT_SURE
}

enum DurationNeeded {
  DAYS
  WEEKS
  MONTHS
  ONE_TO_TWO_YEARS
  MORE_THAN_TWO_YEARS
  UNKNOWN
}

enum UtilityDelay {
  NONE
  UNDER_6_MONTHS
  SIX_TO_12_MONTHS
  ONE_TO_2_YEARS
  MORE_THAN_2_YEARS
  UNKNOWN
}
